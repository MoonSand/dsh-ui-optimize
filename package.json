{
  "name": "@moonsand/dsh-ui-optimize",
  "version": "0.9.26",
  "type": "module",
  "description": "Three features for the DSH web interface, each with its own switch: a minimalist theme gallery (eight themes, one palette for light and one for dark), the desktop Reload/Restart actions at the sidebar foot, and folding the sidebar panel rows into one Panels launcher. · DSH 界面优化：8 套极简主题（浅色与深色各一组配色）+ 侧栏底部的刷新/重启按钮 + 侧栏面板收成一个「面板」入口，三个功能各有独立开关。",
  "license": "MIT",
  "author": "MoonSand",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonSand/dsh-ui-optimize.git"
  },
  "homepage": "https://github.com/MoonSand/dsh-ui-optimize#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "electron",
    "restart"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "desktop-restart.host.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
